# Salin file ini menjadi .env.local untuk pengembangan lokal.
# Di Vercel, tambahkan variabel yang sama di Project Settings → Environment Variables.

# WAJIB — connection string PostgreSQL (Neon / Supabase / Postgres lainnya).
# Gunakan host "pooler" Neon agar aman untuk serverless Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# OPSIONAL — koneksi langsung (tanpa pooler), dipakai `npm run db:init`.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
